# Copy to .env and fill in (or set these in your host's dashboard / shell).
ADMIN_EMAILS=you@email.com,cocaptain@email.com
SESSION_SECRET=paste-a-long-random-string-here
PUBLIC_URL=https://your-machine.tailXXXX.ts.net
RUN_CAP=15
WAITLIST_CAP=5
PREREG_CAP=10
VOTE_THRESHOLD=3
WAIVER_URL=https://example.churchcenter.com/people/forms/0000000

# Contact details filled into the /privacy, /terms and /conduct pages
LEGAL_EFFECTIVE_DATE=January 1, 2026
LEGAL_CONTACT_NAME=Your Name
LEGAL_CONTACT_EMAIL=you@email.com
# Optional: email whose avatar falls back to the hand-placed public/avatars/daniel.jpg
# AVATAR_SEED_EMAIL=you@email.com

# Email (Gmail app password shown; any SMTP works)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=you@gmail.com

# Optional: where the DB file lives (Render: set to your mounted disk)
# DB_PATH=/data/bridge.db
