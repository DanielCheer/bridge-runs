# Copy to .env and fill in (or set these in your host's environment).
# `npm start` / `npm run dev` load .env automatically when it exists.
# Every variable the code reads is listed here; commented-out lines show the default.

# ---------- Server + sessions ----------
# Port to listen on. 3000 is treated as the public port: guard.js refuses test seams on it.
# PORT=3000
# Comma-separated admin emails (full organizer access).
ADMIN_EMAILS=you@email.com,cocaptain@email.com
# Signs the session cookie, and is the root of the at-rest keys for DM bodies and the secrets the
# app keeps in its database (Planning Center credentials, the VAPID private key). Required: the app
# refuses to start without it. Rotating it signs everyone out, makes old DMs unreadable, and
# invalidates those stored secrets: re-enter the Planning Center credentials afterwards (a fresh
# VAPID keypair is generated, so every device has to re-enable notifications).
SESSION_SECRET=paste-a-long-random-string-here
# Throwaway local dev only: start without SESSION_SECRET, signing cookies with a publicly known
# built-in secret. Never in production.
# ALLOW_INSECURE_SESSION=1
# The public origin; magic links, offer emails, share QRs and OAuth redirects are built from it.
PUBLIC_URL=https://your-machine.tailXXXX.ts.net

# ---------- Run rules (defaults; caps are also editable in-app) ----------
RUN_CAP=15
WAITLIST_CAP=5
# How many team/regular players may pre-join while check-in is closed (REGULAR_CAP is its old name).
PREREG_CAP=10
# REGULAR_CAP=10
# Approvals needed to admit an applicant (or rejects to block one).
VOTE_THRESHOLD=3
# Hours a waitlisted player has to claim an offered spot.
# OFFER_WINDOW_HOURS=3
# Pickleball floor cap and waitlist size.
# PK_CAP=20
# PK_WAIT=4
# The waiver form that the waiver QR (/waiver-qr.svg) and its link point at.
WAIVER_URL=https://example.churchcenter.com/people/forms/0000000

# ---------- Policy pages (/privacy, /terms, /conduct) ----------
# Unset values leave a visible [PLACEHOLDER] on the page and a warning at boot.
LEGAL_EFFECTIVE_DATE=January 1, 2026
LEGAL_CONTACT_NAME=Your Name
LEGAL_CONTACT_EMAIL=you@email.com
# The folder holding privacy-policy.md, terms-of-use.md and code-of-conduct.md (default: legal/ in
# the app). Read once at boot: restart after editing a policy.
# LEGAL_DIR=/path/to/your/policies
# Optional: email whose avatar falls back to the hand-placed public/avatars/daniel.jpg.
# AVATAR_SEED_EMAIL=you@email.com

# ---------- Email (any SMTP; Gmail app password shown) ----------
# Without SMTP_HOST + SMTP_USER + SMTP_PASS the app runs in dev mode: sign-in links print to the console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
# Sender address (defaults to SMTP_USER).
SMTP_FROM=you@gmail.com

# ---------- Storage (defaults live inside the app directory) ----------
# DB_PATH=./bridge.db
# AVATARS_DIR=./public/avatars
# CHAT_MEDIA_DIR=./public/chat-media
# Where run banner images are written, and the two banner files.
# BANNER_DIR=./public
# BANNER_PATH=<BANNER_DIR>/gym.jpg
# PK_BANNER_PATH=<BANNER_DIR>/pk-banner.jpg
# Largest chat video upload, in MB.
# CHAT_VIDEO_MAX_MB=40

# ---------- Backups (AES-256-GCM encrypted snapshots, see backup.js) ----------
# BACKUP_DIR=./backups
# Snapshots to keep, and hours between them.
# BACKUP_KEEP=14
# BACKUP_EVERY_HOURS=24
# The key file. Generated on first run; keep a copy somewhere separate from the snapshots.
# BACKUP_KEY_FILE=./backup.key
# A folder a sync client owns (Google Drive, OneDrive, ...) to mirror snapshots off-site. Unset = off.
# BACKUP_OFFSITE_DIR=

# ---------- Planning Center (optional; credentials are entered in-app on /admin/pco) ----------
# API host. Leave unset in production; tests point it at a local mock.
# PCO_API_BASE=https://api.planningcenteronline.com
# Minimum gap between API calls in ms (PCO allows 100 requests per 20 s). 0 disables pacing.
# PCO_PACE_MS=250
# Retry backoff unit for failed outbox writes, in ms (attempt N waits N x this).
# PCO_RETRY_BASE_MS=60000
# How often the door kiosk refreshes Check-Ins arrivals, in ms (floor 5 s).
# PCO_KIOSK_POLL_MS=30000

# ---------- Test-only seams: HARNESS-ONLY, never set these in production ----------
# guard.js refuses every one of these on port 3000. With HARNESS=1 it also requires PORT, DB_PATH,
# BACKUP_DIR, CHAT_MEDIA_DIR, AVATARS_DIR, BANNER_DIR and PCO_API_BASE to point somewhere safe and
# SMTP_HOST to be loopback. See docs/TESTING.md.
# Marks a test instance and turns on the isolation checks.
# HARNESS=1
# Mounts POST /admin/test/tick (runs the scheduler on demand).
# ENABLE_TEST_TICK=1
# Pins the scheduling clock.
# TEST_NOW=2026-01-02T18:00:00
# Releases held late-regulars onto the floor regardless of the 4 PM run-day cutoff.
# FORCE_HELD_RELEASED=1
# Session cookie without the Secure flag, for plain-http localhost.
# COOKIE_INSECURE=1
